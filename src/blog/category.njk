---
layout: base.njk
current: blog
pagination:
  data: collections.categoryList
  size: 1
  alias: cat
permalink: "/blog/category/{{ cat.key }}/"
eleventyComputed:
  title: "{{ cat.label }} | 블로그"
  description: "{{ cat.label }} 관련 글 모음"
  currentCat: "{{ cat.key }}"
---
<section class="page-head"><div class="wrap">
  <h1>{{ cat.label }}</h1>
  <p>글 {{ cat.posts.length }}개</p>
</div></section>
<section class="blog-body"><div class="wrap">
  {% include "cat-nav.njk" %}
  <ul class="post-grid">
    {%- set headingTag = 'h2' %}
    {%- for p in cat.posts %}{% include "post-card.njk" %}{% endfor %}
  </ul>
</div></section>
