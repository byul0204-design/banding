{%- set co = site.company -%}
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <a class="brand" href="/">
        <img src="/assets/img/favicon.svg" alt="" width="32" height="32">
        <span class="brand-text">{{ site.name }}<small>{{ site.tagline }}</small></span>
      </a>
      <nav class="footer-nav" aria-label="하단 메뉴">
        <a href="/#products">제품</a>
        <a href="/#store">무인매장</a>
        <a href="/#cases">설치 사례</a>
        <a href="/#faq">자주 묻는 질문</a>
        <a href="/blog/">블로그</a>
        <a href="/#contact">문의하기</a>
      </nav>
    </div>
    <p class="biz">
      {%- if co.name %}<span>상호 {{ co.name }}</span>{% endif -%}
      {%- if co.ceo %}<span>대표 {{ co.ceo }}</span>{% endif -%}
      {%- if co.bizNumber %}<span>사업자등록번호 {{ co.bizNumber }}</span>{% endif -%}
      {%- if co.address %}<span>주소 {{ co.address }}</span>{% endif -%}
      <span>상담 전화 <a href="tel:{{ site.tel }}" style="color:inherit">{{ site.phone }}</a></span>
      {%- if co.email %}<span>이메일 <a href="mailto:{{ co.email }}" style="color:inherit">{{ co.email }}</a></span>{% endif -%}
    </p>
    <div class="footer-bottom">
      <span>© <span data-year>{{ site.year }}</span> {{ co.name or site.name }}</span>
      <a href="/admin/" rel="nofollow">관리자</a>
    </div>
  </div>
</footer>
<div class="mobile-bar">
  <a class="btn btn-call" href="tel:{{ site.tel }}">전화 상담</a>
  <a class="btn btn-line" href="/#contact">문의 남기기</a>
</div>
