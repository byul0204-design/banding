---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>{{ site.url }}/</loc>
    <lastmod>{{ collections.blogPosts[0].date | dateISO }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>{{ site.url }}/blog/</loc>
    <lastmod>{{ collections.blogPosts[0].date | dateISO }}</lastmod>
    <changefreq>daily</changefreq>
    <priority>0.9</priority>
  </url>
  {%- for c in collections.categoryList %}
  <url>
    <loc>{{ site.url }}/blog/category/{{ c.slug }}/</loc>
    <lastmod>{{ c.posts[0].date | dateISO }}</lastmod>
    <changefreq>weekly</changefreq>
    <priority>0.6</priority>
  </url>
  {%- endfor %}
  {%- for p in collections.blogPosts %}
  <url>
    <loc>{{ site.url }}{{ p.url }}</loc>
    <lastmod>{{ (p.data.updated or p.date) | dateISO }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  {%- endfor %}
</urlset>
