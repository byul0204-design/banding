<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href="/">
      <img src="/assets/img/favicon.svg" alt="" width="32" height="32">
      <span class="brand-text">{{ site.name }}<small>{{ site.tagline }}</small></span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">메뉴 열기</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <nav class="nav" id="site-nav" aria-label="주요 메뉴">
      <a href="/#features">특징</a>
      <a href="/#products">제품</a>
      <a href="/#store">무인매장</a>
      <a href="/#cases">설치 사례</a>
      <a href="/#faq">자주 묻는 질문</a>
      <a href="/blog/"{% if current == 'blog' %} aria-current="page"{% endif %}>블로그</a>
    </nav>
    <a class="btn btn-call header-call" href="tel:{{ site.tel }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
      <span data-phone>{{ site.phone }}</span>
    </a>
  </div>
</header>
