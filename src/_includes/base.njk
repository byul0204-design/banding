<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set desc = description or site.description %}
{%- set canonical = page.url | absUrl %}
<title>{% if fullTitle %}{{ fullTitle }}{% elif title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}</title>
<meta name="description" content="{{ desc }}">
{%- if keywords %}
<meta name="keywords" content="{{ keywords }}">
{%- endif %}
{%- if robots %}
<meta name="robots" content="{{ robots }}">
{%- endif %}
<link rel="canonical" href="{{ canonical }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ ogTitle or title or site.name }}">
<meta property="og:description" content="{{ ogDescription or desc }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ (image or site.ogImage) | absUrl }}">
<meta name="twitter:card" content="summary_large_image">
{%- if site.naverVerification %}
<meta name="naver-site-verification" content="{{ site.naverVerification }}">
{%- endif %}
{%- if site.googleVerification %}
<meta name="google-site-verification" content="{{ site.googleVerification }}">
{%- endif %}
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} 블로그" href="/rss.xml">
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/wanteddev/wanted-sans@v1.0.3/packages/wanted-sans/fonts/webfonts/variable/split/WantedSansVariable.min.css">
<link rel="stylesheet" href="/assets/css/style.css">
{%- for item in jsonLd %}
<script type="application/ld+json">{{ item | dump | safe }}</script>
{%- endfor %}
</head>
<body>
<a class="skip" href="#main">본문 바로가기</a>

{% include "header.njk" %}

<main id="main">
{{ content | safe }}
</main>

{% include "footer.njk" %}

<script src="/assets/js/main.js" defer></script>
</body>
</html>
